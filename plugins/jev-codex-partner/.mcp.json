{
  "mcpServers": {
    "jev_partner": {
      "command": "node",
      "args": ["./server.mjs"],
      "cwd": ".",
      "env_vars": ["AI_GATEWAY_API_KEY", "JEV_OUTCOME_LEDGER_DIR"],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 35,
      "tools": {
        "evaluate": { "approval_mode": "prompt" },
        "record_outcome": { "approval_mode": "prompt" }
      }
    }
  }
}
